<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true"
         failOnRisky="true" cacheResult="false" convertDeprecationsToExceptions="true">
    <testsuites>
        <testsuite name="Faker System Tests">
            <directory suffix="Test.php">tests/System</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="date.timezone" value="UTC"/>
        <ini name="precision" value="14"/>
        <ini name="serialize_precision" value="-1"/>
        <ini name="memory_limit" value="256M"/>
    </php>
    <logging>
        <junit outputFile="results/junit-latest.xml"/>
    </logging>
</phpunit>
